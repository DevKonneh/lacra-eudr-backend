# ── Database ──────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=password
DB_NAME=lacra_eudr
DB_SSL=false

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=your-jwt-secret-here
JWT_EXPIRES_IN=7d

# ── Server ────────────────────────────────────────────────────────────────────
PORT=8100
FRONTEND_URL=http://localhost:5173

# Base URL of THIS backend API (used to build farm-scan QR code URLs).
# In production set to your deployed API domain, e.g. https://api.lacra.com
API_BASE_URL=http://localhost:8100

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated extra origins beyond the built-in defaults
CORS_EXTRA_ORIGINS=

# ── Cloudinary (file uploads) ─────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ── FAO GeoID API ─────────────────────────────────────────────────────────────
# Converts farm GPS geometry into a stable, anonymous GeoID (UUIDv8).
# The same polygon always returns the same GeoID (content-addressed).
# Used for EUDR traceability and WHIMO integration.
#
# Staging:    https://data.review.fao.org/geoid
# Production: https://data.fao.org/geoid
GEOID_BASE_URL=https://data.review.fao.org/geoid

# Named collection for your organisation's farms (recommended for production).
# Register at https://geoid.openforis.org to get a collection ID.
# If left empty, farms register to the public anonymous collection.
GEOID_COLLECTION_ID=lacra-farms

# Bearer token for authenticated collection access (required for named collections).
# Obtain from FAO OpenForis / Keycloak after registering your organisation.
# Leave empty when using the public anonymous collection.
GEOID_API_TOKEN=

# ── WHIMO (EU EUDR due-diligence platform) ────────────────────────────────────
# WHIMO is the EU-designated platform for EUDR due-diligence statements.
# Traders use WHIMO to declare that the commodities they trade are deforestation-free.
#
# LACRA integrates with WHIMO so that the farm QR code payload can pre-fill
# a WHIMO Producer Transaction form with:
#   - farm_latitude / farm_longitude  (centroid of the GPS polygon)
#   - location = "qr"                 (WHIMO TransactionLocation enum)
#   - location_file                   (GeoJSON polygon — uploaded to WHIMO)
#   - commodity_id                    (auto-resolved from LACRA crop type)
#   - is_buying_from_farmer = true
#
# Register at https://whimo.net to obtain an API key and organisation ID.
# Leave blank to use the commodity map and pre-fill features without live WHIMO API calls.
WHIMO_API_BASE_URL=https://api.whimo.net/v1
WHIMO_API_KEY=
WHIMO_ORG_ID=

# ── Rate limits (public/unauthenticated endpoints) ────────────────────────────
# All limits are per-IP, per window (default window: 60 seconds).
# Adjust to match your expected traffic volume in production.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_FARM_SCAN_MAX=120
RATE_LIMIT_WHIMO_PAYLOAD_MAX=30
RATE_LIMIT_PUBLIC_MAX=60

# ── Whisp (deforestation risk) ────────────────────────────────────────────────
WHISP_API_URL=https://whisp.openforis.org/api
WHISP_API_KEY=your-whisp-key

# ── Email ─────────────────────────────────────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@example.com
SMTP_PASS=your-smtp-password
